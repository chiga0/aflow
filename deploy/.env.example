# Copy to lite/deploy/.env (or export these) before `docker compose up`.

# Web login. Leave AFLOW_AUTH_PASSWORD empty to have the runtime generate a
# bootstrap password into the `data` volume on first start (printed in logs).
AFLOW_AUTH_EMAIL=admin@aflow.local
AFLOW_AUTH_PASSWORD=

# Internal token the aflow container uses to reach qwen (qwen binds 0.0.0.0,
# which requires a token). Keep it secret; it never leaves the compose network.
QWEN_SERVE_TOKEN=aflow-internal-token-change-me

# qwen CLI version baked into the qwen image.
QWEN_VERSION=0.21.1

# CORS origin for the web app. "*" is fine for a single self-hosted instance.
AFLOW_CORS_ORIGIN=*

# Only used by the HTTPS overlay (docker-compose.https.yml). Public domain =>
# Let's Encrypt; LAN hostname / IP => Caddy internal CA.
AFLOW_DOMAIN=
