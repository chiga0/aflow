# ── web 登录 ─────────────────────────────────────────────
# 留空 AFLOW_AUTH_PASSWORD 则首次启动生成 bootstrap 密码写入 data/ 目录。
AFLOW_AUTH_EMAIL=admin@aflow.local
AFLOW_AUTH_PASSWORD=
AFLOW_PORT=8765
AFLOW_CORS_ORIGIN=*

# ── 执行引擎 ─────────────────────────────────────────────
# pi（默认）：按需 spawn `pi --mode rpc` 子进程，轻量、跑完即退。
# qwen：常驻 qwen serve daemon（旧路径）。
AFLOW_ENGINE=pi

# pi 引擎（AFLOW_ENGINE=pi）
PI_ENGINE_API_KEY=
PI_ENGINE_MODEL=qwen3.8-max
PI_ENGINE_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# agent 工作目录（容器/裸机上的 workspace）
PI_ENGINE_CWD=

# qwen 引擎（AFLOW_ENGINE=qwen）
QWEN_SERVE_URL=http://127.0.0.1:4170
QWEN_SERVE_TOKEN=aflow-internal-token-change-me
